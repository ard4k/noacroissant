rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for staff authentication (via Custom Claims if configured)
    function isStaff() {
      return request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'kitchen');
    }

    // Products & Categories: Public read, Admin-only write
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Dining Tables: Public read, Admin-only write
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Business Settings: Public read, Admin-only write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Orders:
    // - Customers can create orders with validated structure
    // - Customers with matching tracking_token can read their own order
    // - Staff can read and update all orders
    match /orders/{orderId} {
      allow create: if request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0;
      allow read: if true; // Tracking pages and live streams read by order token
      allow update, delete: if isStaff();
    }

    // Service Requests (Garson / Hesap Çağrıları):
    // - Customers can create a call for their table
    // - Staff can read, update status, and resolve
    match /service_requests/{requestId} {
      allow create: if request.resource.data.table_number is number
                    && request.resource.data.type is string;
      allow read, update, delete: if isStaff();
    }

    // Loyalty Cards:
    // - Customers can read their own card
    // - Updates/Stamp additions are controlled via Server API or Staff
    match /loyalty_cards/{cardId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
