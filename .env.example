# ===================================================
# NOA CROISSANT - ENVIRONMENT CONFIGURATION
# ===================================================

# Application Base URL (Vercel domain or custom domain)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ===================================================
# FIREBASE CONFIGURATION (Recommended for Real-time Cloud DB)
# ===================================================
# Firebase Console > Project Settings > General > Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="noa-croissant.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="noa-croissant"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="noa-croissant.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ===================================================
# ADMIN SECURITY CONFIGURATION
# ===================================================
ADMIN_PIN="330738"
AUTH_SECRET="your-super-secret-key-min-32-chars-long-for-jwt-signing"

